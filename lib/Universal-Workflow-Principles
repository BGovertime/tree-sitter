GitHub Actions CI/CD Pipeline with Docker & Kubernetes
name: CI/CD Pipeline with Docker & Kubernetes

on:
  push:
    branches:
- main # This executes when there is a commit on the main branch.
  pull_request:
    branches:
- main # This function executes when a PR is created in main.
workflow_dispatch: # Can be triggered manually

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      # 1. Checkout repository
      - name: Checkout repository
        uses: actions/checkout@v3

      # 2. Setup Docker
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v2

      # 3. Login to Docker Registry
      - name: Login to DockerHub
        uses: docker/login-action@v2
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      # 4. Build and Push Docker Image
      - name: Build and Push Docker Image
        uses: docker/build-push-action@v4
        with:
          context: .
          push: true
          tags: ${{ secrets.DOCKER_USERNAME }}/streaming-app:latest

  deploy:
    runs-on: ubuntu-latest
    needs: build
    steps:
      # 5. Checkout repository
      - name: Checkout repository
        uses: actions/checkout@v3

      # 6. Setup kubectl
      - name: Set up kubectl
        uses: azure/setup-kubectl@v3
        with:
          version: 'v1.28.0'

# 7. Setup Kubeconfig (Connecting to the cluster)
      - name: Configure Kubeconfig
        run: |
mkdir -p ~/.kube
          echo "${{ secrets.KUBECONFIG }}" > ~/.kube/config

      # 8. Deploy to Kubernetes
      - name: Deploy to Kubernetes
        run: |
          kubectl set image deployment/streaming-app streaming-app=${{ secrets.DOCKER_USERNAME }}/streaming-app:latest
          kubectl rollout status deployment/streaming-app


